+#if PL022_RXDMA_STALL_RECOVERY
+/*
+ * RX-DMA stall recovery watchdog.
+ *
+ * Armed when a DMA transfer is issued (configure_dma), disarmed on normal
+ * completion (dma_callback) or teardown (terminate_dma).
+ *
+ * Confirmed failure mode (captured on HW): the SPI is internally full-duplex,
+ * so every TX frame clocks an RX frame into the RX FIFO even though MISO is not
+ * wired. The RX FIFO is drained by EDMAC into a throwaway buffer. Under load the
+ * EDMAC is occasionally late, the RX FIFO overruns once (RORMIS), and one burst
+ * worth of RX frames is dropped (written to the shift register, not the FIFO).
+ * The RX DMA is programmed for the full byte count, so it ends up a few bytes
+ * short forever: TX completes (res=0, BSY=0, bus idle) but RX residue freezes
+ * (e.g. res=8) and dma_callback never fires -> spi_sync() would wait forever.
+ *
+ * The lost bytes are garbage and unrecoverable (bus is idle, they will never
+ * arrive), and the panel already got the frame from the completed TX side, so
+ * the only sane action is to abort this transfer and move on.
+ */
+static void terminate_dma(struct pl022 *pl022);		/* forward decl for recovery */
+
+static void pl022_rxdma_stall_watchdog(struct timer_list *t)
+{
+	struct pl022 *pl022 = from_timer(pl022, t, stall_timer);
+	struct spi_message *msg = pl022->cur_msg;
+	void __iomem *base = pl022->virtbase;
+	struct dma_tx_state rxtx = {0}, txtx = {0};
+	enum dma_status rxs = DMA_COMPLETE, txs = DMA_COMPLETE;
+	u16 sr   = readw(SSP_SR(base));
+	u16 ris  = readw(SSP_RIS(base));
+	u16 mis  = readw(SSP_MIS(base));
+	u16 imsc = readw(SSP_IMSC(base));
+	u16 cr1  = readw(SSP_CR1(base));
+
+	if (pl022->dma_rx_channel)
+		rxs = dmaengine_tx_status(pl022->dma_rx_channel,
+					  pl022->stall_rx_cookie, &rxtx);
+	if (pl022->dma_tx_channel)
+		txs = dmaengine_tx_status(pl022->dma_tx_channel,
+					  pl022->stall_tx_cookie, &txtx);
+
+	dev_err(&pl022->adev->dev,
+	       "RX-DMA stalled %ums, aborting frame (-EIO) | len=%u | SR=0x%03x BSY=%d RFF=%d RNE=%d TNF=%d TFE=%d | RIS=0x%x MIS=0x%x IMSC=0x%x SSE=%d | RXdma st=%d res=%u | TXdma st=%d res=%u | overrun=%u\n",
+	       jiffies_to_msecs(jiffies - pl022->stall_start),
+	       pl022->stall_xfer_len, sr,
+	       !!(sr & SSP_SR_MASK_BSY), !!(sr & SSP_SR_MASK_RFF),
+	       !!(sr & SSP_SR_MASK_RNE), !!(sr & SSP_SR_MASK_TNF),
+	       !!(sr & SSP_SR_MASK_TFE),
+	       ris, mis, imsc, !!(cr1 & SSP_CR1_MASK_SSE),
+	       rxs, (unsigned int)rxtx.residue,
+	       txs, (unsigned int)txtx.residue,
+	       pl022->stall_overrun_cnt);
+
+	/*
+	 * Recovery: the RX DMA can never complete now. RX data was lost to an
+	 * overrun and the bus is idle (BSY=0, TX drained), so the missing tail
+	 * bytes will never arrive and the RX residue is frozen forever. The TX
+	 * side already finished, so the panel already received this frame; the
+	 * RX is throwaway for a write-only display. Abort instead of waiting:
+	 * tear down both DMA channels, quiesce the controller, mark the message
+	 * STATE_ERROR and let pump_transfers() give it back with -EIO. Do NOT
+	 * re-arm here; the next frame re-arms via configure_dma().
+	 */
+	if (!msg)
+		return;				/* already given back */
+	terminate_dma(pl022);
+	writew(DISABLE_ALL_INTERRUPTS, SSP_IMSC(base));
+	writew(CLEAR_ALL_INTERRUPTS, SSP_ICR(base));
+	writew(readw(SSP_CR1(base)) & ~SSP_CR1_MASK_SSE, SSP_CR1(base));
+	msg->state = STATE_ERROR;
+	tasklet_schedule(&pl022->pump_transfers);
+}
+
+static inline void pl022_rxdma_stall_arm(struct pl022 *pl022)
+{
+	pl022->stall_overrun_cnt = 0;
+	pl022->stall_xfer_len = pl022->cur_transfer ? pl022->cur_transfer->len : 0;
+	pl022->stall_start = jiffies;
+	/*
+	 * Abort timeout = 500ms (HZ/2). The worst measured *healthy* transfer
+	 * (incl. flow-control throttling under load) is ~70ms, so this is ~7x
+	 * margin: deadlocked transfers are aborted quickly while legitimately
+	 * slow ones are never false-killed. Don't go below ~300ms without data
+	 * on the real worst-case transfer time -- false aborts (dropped frames)
+	 * are more harmful and more frequent than the rare (~hours) deadlock.
+	 */
+	mod_timer(&pl022->stall_timer, jiffies + HZ / 2);
+}
+#endif /* PL022_RXDMA_STALL_RECOVERY */
+
 static void dma_callback(void *data)
 {
 	struct pl022 *pl022 = data;
 	struct spi_message *msg = pl022->cur_msg;
 
+#if PL022_RXDMA_STALL_RECOVERY
+	del_timer(&pl022->stall_timer);	/* transfer completed normally */
+#endif
 	BUG_ON(!pl022->sgt_rx.sgl);
 
 #ifdef VERBOSE_DEBUG
@@ -1035,6 +1147,29 @@
 		tx_conf.dst_addr_width = rx_conf.src_addr_width;
 	BUG_ON(rx_conf.src_addr_width != tx_conf.dst_addr_width);
 
+#ifdef CONFIG_ARCH_BSP
+	/*
+	 * Fix DMA burst size and FIFO waterline to 4 for both TX and RX.
+	 * Tested values on Hi3516CV610:
+	 *   burst=16: RX FIFO overrun (ROR) - FIFO fills before DMA responds,
+	 *             causes SPI DMA to hang (kworker blocked > 120s).
+	 *   burst=8:  RX FIFO overrun (ROR) - same root cause; more frequent
+	 *             due to smaller FIFO headroom and higher DMA request rate.
+	 *   burst=4:  Optimal. Sufficient RX FIFO headroom, no overrun observed
+	 *             in testing. Burst size equals waterline as DMAC requires.
+	 *   burst=1:  No overrun, but too many DMA requests degrade SPI
+	 *             transfer throughput noticeably.
+	 * FIFO_CR encoding: 0x00=1, 0x01=4, 0x02=8, 0x03=16 words per burst.
+	 */
+	{
+		u16 fifo_dma_cr = 0x01; /* burst=4, FIFO_CR=0x01 */
+		tx_conf.dst_maxburst = 4;
+		rx_conf.src_maxburst = 4;
+		writew(fifo_dma_cr, VENDOR_SSP_TX_FIFO_CR(pl022->virtbase));
+		writew(fifo_dma_cr, VENDOR_SSP_RX_FIFO_CR(pl022->virtbase));
+	}
+#endif
+
 	dmaengine_slave_config(rxchan, &rx_conf);
 	dmaengine_slave_config(txchan, &tx_conf);
 
