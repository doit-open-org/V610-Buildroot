Bluetooth: reset the advertising data caches when an instance is removed

The data caches are shared by all advertising instances. Removing an
extended advertising set clears its controller-side data, so the caches
must be invalidated before the same instance is created again.

--- a/net/bluetooth/hci_core.c
+++ b/net/bluetooth/hci_core.c
@@ -2919,6 +2919,15 @@ int hci_remove_adv_instance(struct hci_dev *hdev, u8 instance)
 
 	cancel_delayed_work_sync(&adv_instance->rpa_expired_cb);
 
+	/* The data caches are shared by all advertising instances. Removing an
+	 * extended advertising set clears its controller-side data, so invalidate
+	 * the caches before the same instance is created again.
+	 */
+	memset(hdev->adv_data, 0, sizeof(hdev->adv_data));
+	hdev->adv_data_len = 0;
+	memset(hdev->scan_rsp_data, 0, sizeof(hdev->scan_rsp_data));
+	hdev->scan_rsp_data_len = 0;
+
 	list_del(&adv_instance->list);
 	kfree(adv_instance);
 
