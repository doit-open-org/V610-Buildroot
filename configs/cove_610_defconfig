# Architecture: Cortex-A7, soft-float EABI with NEON/VFPv4 (softfp),
# the ABI of the prebuilt HiSilicon MPP libraries.
BR2_arm=y
BR2_cortex_a7=y
BR2_ARM_EABI=y
BR2_ARM_FPU_NEON_VFPV4=y

# Toolchain: HiSilicon GCC 10.3 / musl 1.2.3 (v01c02), the one the
# V2.1.0 MPP libraries were built with. Installed from its tarball so that
# "make sdk" exports a self-contained SDK. It is a multilib toolchain;
# the options above select its a7_softfp_neon-vfpv4 variant.
BR2_TOOLCHAIN_EXTERNAL=y
BR2_TOOLCHAIN_EXTERNAL_CUSTOM=y
BR2_TOOLCHAIN_EXTERNAL_DOWNLOAD=y
BR2_TOOLCHAIN_EXTERNAL_URL="file://$(BR2_EXTERNAL_CV610_PATH)/vendor/gcc-10.3-arm-musl-x86-linux-26.06.1-codesize.tgz"
BR2_TOOLCHAIN_EXTERNAL_REL_BIN_PATH="arm-v01c02-linux-musleabi-gcc/bin"
BR2_TOOLCHAIN_EXTERNAL_CUSTOM_PREFIX="arm-v01c02-linux-musleabi"
BR2_TOOLCHAIN_EXTERNAL_GCC_10=y
BR2_TOOLCHAIN_EXTERNAL_HEADERS_5_10=y
BR2_TOOLCHAIN_EXTERNAL_CUSTOM_MUSL=y
BR2_TOOLCHAIN_EXTERNAL_CXX=y
BR2_TOOLCHAIN_EXTERNAL_OPENMP=y

# System
BR2_GLOBAL_PATCH_DIR="$(BR2_EXTERNAL_CV610_PATH)/board/cove_610/patches"
BR2_TARGET_GENERIC_HOSTNAME="cove-610"
BR2_TARGET_GENERIC_ISSUE="Welcome to Cove-610 (Hi3516CV610)"
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_MDEV=y
# /lib, /bin and /sbin are links into /usr: programs and scripts written
# for the vendor image address the MPP libraries as /lib/<name>.so.
BR2_ROOTFS_MERGED_USR=y
BR2_TARGET_GENERIC_ROOT_PASSWD="123456"
BR2_TARGET_GENERIC_GETTY_PORT="ttyAMA0"
BR2_TARGET_GENERIC_GETTY_BAUDRATE_115200=y
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_CV610_PATH)/board/cove_610/rootfs_overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_CV610_PATH)/board/cove_610/post-build.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_CV610_PATH)/board/cove_610/post-image.sh"

# Kernel: vendor 5.10.221 tree. The tarball name carries the SDK tag so that
# a kernel cached in dl/ from another SDK version is never picked up.
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_TARBALL=y
BR2_LINUX_KERNEL_CUSTOM_TARBALL_LOCATION="file://$(BR2_EXTERNAL_CV610_PATH)/vendor/linux-5.10.y-tag_V2.1.0_Beta.tgz"
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="$(BR2_EXTERNAL_CV610_PATH)/board/cove_610/linux.config"
BR2_LINUX_KERNEL_ZIMAGE=y
BR2_LINUX_KERNEL_DTS_SUPPORT=y
BR2_LINUX_KERNEL_CUSTOM_DTS_DIR="$(BR2_EXTERNAL_CV610_PATH)/board/cove_610/dts"

# Packages
BR2_PACKAGE_BUSYBOX_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_CV610_PATH)/board/cove_610/busybox.fragment"
BR2_PACKAGE_DROPBEAR=y
BR2_PACKAGE_LRZSZ=y
BR2_PACKAGE_WPA_SUPPLICANT=y
BR2_PACKAGE_WPA_SUPPLICANT_NL80211=y
BR2_PACKAGE_WPA_SUPPLICANT_AP_SUPPORT=y
BR2_PACKAGE_WPA_SUPPLICANT_CLI=y
BR2_PACKAGE_WPA_SUPPLICANT_PASSPHRASE=y
BR2_PACKAGE_HISI_OSDRV=y
BR2_PACKAGE_HISI_BOOT=y
BR2_PACKAGE_AIC8800D_SDIO=y
BR2_PACKAGE_AIC8800D_SDIO_BLE=y
BR2_PACKAGE_LCD_DRIVER=y
BR2_PACKAGE_TOUCH_DRIVER=y
BR2_PACKAGE_BLUEZ5_UTILS_CLIENT=y
# DRM userspace library, for applications that link it from the image.
BR2_PACKAGE_LIBDRM=y
# fw_printenv / fw_setenv, used by sdio1-pins to choose the device tree.
BR2_PACKAGE_UBOOT_TOOLS=y

# Root filesystem: UBIFS for 2 KiB page / 128 KiB block SPI NAND,
# 59 MiB partition (472 LEBs). Keep in step with board/cove_610/flash.cfg.
BR2_TARGET_ROOTFS_UBI=y
BR2_TARGET_ROOTFS_UBI_PEBSIZE=0x20000
BR2_TARGET_ROOTFS_UBI_SUBSIZE=0
BR2_TARGET_ROOTFS_UBI_USE_CUSTOM_CONFIG=y
BR2_TARGET_ROOTFS_UBI_CUSTOM_CONFIG_FILE="$(BR2_EXTERNAL_CV610_PATH)/board/cove_610/ubinize.cfg"
BR2_TARGET_ROOTFS_UBIFS=y
BR2_TARGET_ROOTFS_UBIFS_LEBSIZE=0x1f000
BR2_TARGET_ROOTFS_UBIFS_MINIOSIZE=0x800
BR2_TARGET_ROOTFS_UBIFS_MAXLEBCNT=472
BR2_TARGET_ROOTFS_UBIFS_OPTS="-F"
# BR2_TARGET_ROOTFS_TAR is not set

# Host tools for the FIT image and the U-Boot environment
BR2_PACKAGE_HOST_DTC=y
BR2_PACKAGE_HOST_UBOOT_TOOLS=y
BR2_PACKAGE_HOST_UBOOT_TOOLS_FIT_SUPPORT=y
