config BR2_PACKAGE_BOARD_IO_CFG
	bool "board-io-cfg (Hi3516CV610 board pin configuration module)"
	depends on BR2_LINUX_KERNEL
	help
	  Kernel module that applies the board pin configuration: on
	  load it reads the pin-cfg nodes of the device tree
	  (board_io_config.dtsi), looks the pins up in its built-in
	  IOCFG tables and writes the registers.

	  Installed as /drv/ko/ot_board_io_cfg.ko. The LCD and touch
	  control scripts load it before their drivers.

comment "board-io-cfg needs a Linux kernel"
	depends on !BR2_LINUX_KERNEL
